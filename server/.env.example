# SecureShare server configuration — copy to .env to override defaults.
# No secrets are needed: this server never handles keys or passphrases.

# Port the API listens on
PORT=3001

# Where encrypted blobs + metadata live (default: ./storage)
# STORAGE_DIR=./storage

# Maximum upload size in MB (ciphertext)
MAX_FILE_MB=25

# Public URL of the SecureShare app (Expo web). Share links (/d/<id>)
# redirect here, preserving the #key= fragment in the browser.
APP_URL=http://localhost:8081

# How often expired files are swept (ms, default 5 minutes)
SWEEP_INTERVAL_MS=300000

# Extra allowed CORS origins, comma-separated (localhost is always allowed)
# CORS_ORIGINS=https://secureshare.example.com
